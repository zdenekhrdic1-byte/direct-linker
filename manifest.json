{
  "manifest_version": 3,
  "name": "Direct Linker",
  "version": "1.0",
  "description": "Capture direct download links and filenames effortlessly.",
  "permissions": ["downloads", "storage"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}